# Không bắt buộc khi chạy local với docker-compose.yml mặc định (src/config.js đã có giá trị mặc định cho dev).
# Copy thành .env rồi chạy: node --env-file=.env src/server.js
PORT=3000
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
TEST_DATABASE_URL=postgres://shop:shop@localhost:5432/shop_test
JWT_SECRET=dev-secret-change-me
TOKEN_TTL_SEC=3600
