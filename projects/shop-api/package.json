{
  "name": "shop-api",
  "version": "1.0.0",
  "private": true,
  "description": "API cửa hàng thật: Express + PostgreSQL + Docker — dự án thực hành của JS Learn",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:core": "node --test --test-concurrency=1 test/core.test.js",
    "task": "node scripts/task.js",
    "check-solutions": "node scripts/check-solutions.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "pg": "8.23.0"
  }
}
